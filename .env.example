# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Bearer keys external clients must send: Authorization: Bearer <key>
# Name them so each person or agent can be revoked on its own:
#   API_KEYS="devin=<key>,tarou=<key>"
# Generate one with: openssl rand -hex 32
API_KEYS=

# Requests per key per window before HTTP 429.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

HOST=127.0.0.1
PORT=3000

# Comma-separated guild (server) IDs the API may expose. Empty = every server the bot is in.
ALLOWED_GUILD_IDS=

# Allow POST /api/channels/:id/messages (requires Send Messages permission on the bot)
ENABLE_WRITE=false

# GitHub webhook relay (optional). Both must be set to enable POST /webhooks/github.
GITHUB_WEBHOOK_SECRET=
GITHUB_NOTIFY_CHANNEL_ID=
